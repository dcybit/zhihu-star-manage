{
  "manifest_version": 3,
  "name": "知乎收藏夹批量管理",
  "version": "1.0.0",
  "description": "批量查看、筛选、取消收藏和导出知乎收藏夹内容。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "知乎收藏夹批量管理",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "storage"],
  "host_permissions": ["https://www.zhihu.com/*", "https://api.zhihu.com/*"]
}
