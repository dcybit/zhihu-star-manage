{
  "manifest_version": 3,
  "name": "知乎收藏夹批量管理",
  "version": "1.2.0",
  "description": "批量管理知乎收藏夹与关注域：支持回答/文章/想法/视频的批量取消收藏、移动、导出，支持问题/专栏的批量取关。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "知乎收藏夹批量管理",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "storage", "scripting"],
  "host_permissions": ["https://www.zhihu.com/*", "https://api.zhihu.com/*"]
}
